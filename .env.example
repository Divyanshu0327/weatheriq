# WeatherIQ Environment Variable Configuration Example

# MongoDB Connection (Required - Standard Spring Boot Data MongoDB URI)
# Localhost Example:
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/weatheriq

# Production / MongoDB Atlas Example:
# SPRING_DATA_MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@weatheriq.asqhhup.mongodb.net/weatheriq?retryWrites=true&w=majority

# Security & JWT Token Signing (Generate a strong 256-bit+ secret in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=86400000

# Mail / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# Application Links & Expiry
FRONTEND_URL=http://localhost:5173
VERIFICATION_TOKEN_EXPIRY_MINUTES=10

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Open-Meteo API URLs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
