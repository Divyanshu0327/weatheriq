{
	"info": {
		"_postman_id": "weatheriq-api-collection-2026",
		"name": "WeatherIQ REST API Collection",
		"description": "Complete production REST API collection for WeatherIQ - Weather Intelligence & Personal Alerts Platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		}
